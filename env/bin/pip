#!/Users/awingsuma/Downloads/repos/ExamInsight/env/bin/python3

import sys  # System module
from pip._internal.cli.main import main  # pip package manager CLI launcher

if __name__ == '__main__':  # Script entry point
    if sys.argv[0].endswith('.exe'):  # Check for .exe extension
        sys.argv[0] = sys.argv[0][:-4]  # Strip .exe extension
    sys.exit(main())  # Run pip CLI and exit