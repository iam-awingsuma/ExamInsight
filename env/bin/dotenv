#!/Users/awingsuma/Downloads/repos/ExamInsight/env/bin/python3

import sys  # System-specific parameters and functions module
from dotenv.__main__ import cli  # Main CLI entry point execution function for python-dotenv

if __name__ == '__main__':  # Runs script logic only when executed directly as main program
    if sys.argv[0].endswith('.exe'):  # Checks if script path ends with executable extension (.exe)
        sys.argv[0] = sys.argv[0][:-4]  # Strips .exe extension from command name argument
    sys.exit(cli())  # Executes dotenv CLI interface and exits with returned status code